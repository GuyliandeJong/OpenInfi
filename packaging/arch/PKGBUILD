# Builds the package from the git checkout this file lives in:
#   cd packaging/arch && makepkg -si
pkgname=openinfi
replaces=('infi75')
conflicts=('infi75')
pkgver=0.1.0
pkgrel=1
pkgdesc="OpenInfi: open-source configurator for the Infiverse INFI75 keyboard (lighting, remapping, macros, screen, clock)"
arch=('any')
url="https://github.com/GuyliandeJong/OpenInfi"
license=('MIT')
depends=('python' 'python-hidapi' 'python-pillow' 'python-pyusb' 'libusb')
optdepends=('pyside6: graphical configurator (openinfi gui)')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
install=openinfi.install

_root() { realpath "$startdir/../.."; }

pkgver() {
  local base
  base=$(sed -n 's/^version = "\(.*\)"/\1/p' "$(_root)/pyproject.toml")
  printf '%s.r%s.g%s' "$base" "$(git -C "$(_root)" rev-list --count HEAD)" \
    "$(git -C "$(_root)" rev-parse --short HEAD)"
}

build() {
  rm -rf "$srcdir/openinfi"
  git -C "$(_root)" archive --format=tar --prefix=openinfi/ HEAD | tar -x -C "$srcdir"
  cd "$srcdir/openinfi"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/openinfi"
  python -m installer --destdir="$pkgdir" dist/*.whl

  local run=(env PYTHONPATH=src python -c)
  install -d "$pkgdir/usr/lib/udev/rules.d" "$pkgdir/usr/lib/systemd/user" \
    "$pkgdir/usr/share/applications" "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  PYTHONPATH=src python -m openinfi udev > "$pkgdir/usr/lib/udev/rules.d/70-openinfi.rules" 2>/dev/null
  "${run[@]}" 'from openinfi import clock; print(clock.service_text("/usr/bin/openinfi"), end="")' \
    > "$pkgdir/usr/lib/systemd/user/openinfi-clock.service"
  "${run[@]}" 'from openinfi import clock; print(clock.timer_text(clock.DEFAULT_EVERY), end="")' \
    > "$pkgdir/usr/lib/systemd/user/openinfi-clock.timer"
  "${run[@]}" 'from openinfi import desktop; print(desktop.entry_text("/usr/bin/openinfi"), end="")' \
    > "$pkgdir/usr/share/applications/openinfi.desktop"
  install -m644 src/openinfi/data/openinfi.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/openinfi.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
